        <result property="isDeleted" column="is_deleted"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,conversation_id,from_user_id,target_user_id,group_id,content,
        type,extra,duration,file_name,file_size,
        file_type,file_url,thumb_url,is_deleted,create_time,
